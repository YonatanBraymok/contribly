# Copy to server/.env for running the API outside Docker (`npm run dev:server`).
# When running via docker-compose, these come from the root .env instead.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must match the vector(n) columns in supabase/migrations.
EMBEDDING_DIMENSIONS=1536
