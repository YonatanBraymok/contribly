{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Contribly API — matching engine for open-source contributions.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixture:capture": "tsx src/scripts/analyze-fixture.ts capture",
    "fixture:analyze": "tsx src/scripts/analyze-fixture.ts analyze",
    "ingest:repos": "tsx src/scripts/ingest-repositories.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3"
  }
}
