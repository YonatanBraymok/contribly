# Copy to .env — docker-compose reads this file automatically.
# Never commit the real .env.

# --- Published host ports ---------------------------------------------------
# Change these if something else on your machine already owns the port.
WEB_PORT=3000
API_PORT=4000

# --- Local Postgres (docker-compose `db` service) ---------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contribly
# Host port; 5432 is left free for any local Postgres you already run.
POSTGRES_PORT=54322

# --- Supabase ---------------------------------------------------------------
# From your Supabase project: Settings → API. The two URLs take the same value;
# they are separate variables because two different processes read them.
SUPABASE_URL=
# Server-side only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Safe to ship to the browser (RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Authentication ---------------------------------------------------------
# Sign-in is GitHub OAuth via Supabase Auth. There is no password path, so
# turn Email off under Authentication → Sign In / Providers and leave GitHub as
# the only enabled provider. Setup steps are in the README.
#
# Absolute origin of the client, used to build the OAuth redirect URL. Optional
# locally (inferred from request headers); set it wherever a proxy sits in front.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
